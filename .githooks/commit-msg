#!/bin/sh
# Strip Cursor attribution trailers. Reject an empty message after the strip.
set -eu

. "$(dirname "$0")/cursor-attribution.sh"

msg_file="${1:?commit-msg: missing message file}"
strip_cursor_trailers "$msg_file"

if ! grep -qEv '^[[:space:]]*(#|$)' "$msg_file"; then
	echo "commit-msg: message is empty after stripping Cursor attribution" >&2
	exit 1
fi

rewrite_cursor_identity
